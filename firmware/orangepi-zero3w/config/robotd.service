[Unit]
Description=Microduck control.43
After=local-fs.target systemd-sysusers.service
ConditionPathExists=/dev/ttyS2

[Service]
Type=exec
User=root
Group=robot
Environment=ORT_DYLIB_PATH=/opt/robot/feetech-ft5-r5/onnxruntime/libonnxruntime.so.1.28.0
Environment=RUST_LOG=info
ExecStart=/opt/robot/feetech-ft5-r5/robotd --socket /run/robotd.sock --params /etc/robot/feetech-ft5/robotd.toml --port /dev/ttyS2 --read-only
RuntimeDirectory=robotd
Restart=no
TimeoutStopSec=15

# Manual commissioning; the existing console can configure motion after calibration.
