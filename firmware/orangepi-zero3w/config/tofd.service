[Unit]
Description=Microduck ToF
After=local-fs.target systemd-sysusers.service
ConditionPathExists=/dev/i2c-pihat

[Service]
Type=exec
User=root
Group=robot
ExecStart=/opt/robot/tof-stage1/tofd --bus /dev/i2c-pihat --no-imu --config /etc/robot/feetech-ft5/robotd.toml
RuntimeDirectory=tofd
Restart=no
